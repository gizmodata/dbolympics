#!/bin/bash
# Starts ClickHouse; the Umbra container is started by the benchmark runner (system.toml).
set -e

# The server sizes itself for the container: as many threads as its cores, 90% of its memory limit.
sudo clickhouse start

# the query program, for the whole run: the runner's protocol on /run/dbo/dbo.sock
nohup ./query >/run/dbo/query.log 2>&1 &
echo $! > query.pid
